<%- include('partials/header') %>
<div class="auth-background">
  <div class="container">
    <div class="row" style="margin-bottom: 0;">
      <div class="col s12 m6 offset-m3 l4 offset-l4">
        <div class="glass-card">
          <h2 class="card-title center-align">Iniciar<br>Sesión</h2>
          <p class="card-subtitle center-align">Accede a los archivos clasificados del museo</p>
          <form id="signInForm">
            <div class="input-field">
              <input id="email" type="email" required>
              <label for="email">Email</label>
            </div>
            <div class="input-field">
              <input id="password" type="password" required>
              <label for="password">Contraseña</label>
            </div>
            <button class="btn btn-accent w-100" type="submit" style="width: 100%; margin-top: 25px;">Ingresar &rarr;</button>
          </form>
          <p class="center-align" style="margin-top: 30px;">
            ¿No tienes cuenta? <a href="/signUp">Regístrate aquí</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  document.getElementById('signInForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('email').value;
    const password = document.getElementById('password').value;
    try {
      const res = await fetch('/api/auth/signIn', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password })
      });
      const data = await res.json();
      if (res.ok) {
        setToken(data.token);
        const decoded = parseJwt(data.token);
        if (decoded.roles.includes('admin')) window.location.href = '/admin/dashboard';
        else window.location.href = '/dashboard';
      } else {
        M.toast({html: data.message || 'Error al iniciar sesión', classes: 'red'});
      }
    } catch (err) {
      M.toast({html: 'Error de red', classes: 'red'});
    }
  });
</script>
<%- include('partials/footer') %>
