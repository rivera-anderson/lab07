<%- include('partials/header') %>
<div class="auth-background">
  <div class="container">
    <div class="row" style="margin-bottom: 0;">
      <div class="col s12 m8 offset-m2 l6 offset-l3">
        <div class="glass-card" style="margin-top: 40px;">
          <h2 class="card-title center-align">Únete a la<br>Expedición</h2>
          <p class="card-subtitle center-align">Regístrate para explorar las colecciones del museo</p>
          <form id="signUpForm">
            <div class="row">
              <div class="input-field col s6">
                <input id="name" type="text" required>
                <label for="name">Nombre</label>
              </div>
              <div class="input-field col s6">
                <input id="lastName" type="text" required>
                <label for="lastName">Apellido</label>
              </div>
            </div>
            <div class="row">
              <div class="input-field col s12 m6">
                <input id="email" type="email" required>
                <label for="email">Email</label>
              </div>
              <div class="input-field col s12 m6">
                <input id="password" type="password" required>
                <label for="password">Contraseña</label>
                <div class="password-hints">
                  <p class="hint-title">La contraseña debe contener:</p>
                  <ul>
                    <li id="hint-length"><i class="material-icons tiny">close</i> Mínimo 8 caracteres</li>
                    <li id="hint-upper"><i class="material-icons tiny">close</i> Al menos 1 mayúscula</li>
                    <li id="hint-digit"><i class="material-icons tiny">close</i> Al menos 1 dígito</li>
                    <li id="hint-special"><i class="material-icons tiny">close</i> Al menos 1 carácter especial (# $ % & * @)</li>
                  </ul>
                </div>
              </div>
            </div>
            <div class="row">
              <div class="input-field col s12 m6">
                <input id="phoneNumber" type="text" required>
                <label for="phoneNumber">Teléfono</label>
              </div>
              <div class="input-field col s12 m6">
                <input id="birthdate" type="date" required>
                <label for="birthdate" class="active">Fecha de Nacimiento</label>
              </div>
            </div>
            <button class="btn btn-accent w-100" type="submit" style="width: 100%; margin-top: 15px;">Registrarse &rarr;</button>
          </form>
          <p class="center-align" style="margin-top: 30px;">
            ¿Ya tienes cuenta? <a href="/signIn">Inicia Sesión</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  // Live password validation hints
  const passwordInput = document.getElementById('password');
  passwordInput.addEventListener('input', function() {
    const val = this.value;
    validateHint('hint-length', val.length >= 8);
    validateHint('hint-upper', /[A-Z]/.test(val));
    validateHint('hint-digit', /[0-9]/.test(val));
    validateHint('hint-special', /[#$%&*@]/.test(val));
  });

  function validateHint(id, isValid) {
    const el = document.getElementById(id);
    const icon = el.querySelector('i');
    if (isValid) {
      el.classList.add('valid');
      el.classList.remove('invalid');
      icon.textContent = 'check';
    } else {
      el.classList.remove('valid');
      el.classList.add('invalid');
      icon.textContent = 'close';
    }
  }

  document.getElementById('signUpForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = document.getElementById('email').value;
    const password = document.getElementById('password').value;
    const payload = {
      name: document.getElementById('name').value,
      lastName: document.getElementById('lastName').value,
      email: email,
      password: password,
      phoneNumber: document.getElementById('phoneNumber').value,
      birthdate: document.getElementById('birthdate').value
    };
    try {
      const res = await fetch('/api/auth/signUp', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await res.json();
      if (res.ok) {
        M.toast({html: 'Registro exitoso. Ingresando...', classes: 'green'});
        // Auto-login after successful registration
        const loginRes = await fetch('/api/auth/signIn', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        });
        const loginData = await loginRes.json();
        if (loginRes.ok) {
          setToken(loginData.token);
          const decoded = parseJwt(loginData.token);
          if (decoded.roles.includes('admin')) window.location.href = '/admin/dashboard';
          else window.location.href = '/dashboard';
        } else {
          window.location.href = '/signIn';
        }
      } else {
        M.toast({html: data.message || 'Error en el registro', classes: 'red'});
      }
    } catch (err) {
      M.toast({html: 'Error de red', classes: 'red'});
    }
  });
</script>
<%- include('partials/footer') %>
