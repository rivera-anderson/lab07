<%- include('partials/header') %>

<div class="museum-hero">
  <div class="museum-hero-content">
    <span class="hero-tag">01 / Colección Permanente</span>
    <h1>DESCUBRE<br><span class="accent">EL PASADO</span><br>// PREHISTÓRICO</h1>
    <p>Nuestra exposición permanente presenta los hallazgos paleontológicos más asombrosos del mundo, preservados para la humanidad.</p>
    <button class="btn btn-accent" style="margin-top: 10px;">Adquirir Entrada &nearr;</button>
  </div>
</div>

<div class="elegant-container">
  <div class="section-header">
    <span class="section-tag">02 / Exhibiciones Destacadas</span>
    <h2 class="section-title">EXPLORA LAS<br><span class="accent">COLECCIONES</span></h2>
  </div>

  <div class="container">
    <div class="row">
      <!-- Exhibit 1 -->
      <div class="col s12 m6 l4" style="margin-bottom: 30px;">
        <div class="exhibit-card animate-in animate-in-delay-1">
          <div class="exhibit-img-container">
            <span class="exhibit-tag-overlay">Cretácico / Sala 01</span>
            <img src="https://images.unsplash.com/photo-1518991669955-9c7e78ec80ca?q=80&w=800" alt="T-Rex">
          </div>
          <div class="exhibit-content">
            <div class="exhibit-meta">
              <span class="exhibit-period">Periodo Cretácico</span>
              <span class="exhibit-tag">Permanente</span>
            </div>
            <h3 class="exhibit-title">El Rey de los Tiranos</h3>
            <p class="exhibit-desc">Esqueleto completo de Tyrannosaurus Rex. El depredador más temido de la era mesozoica.</p>
            <div class="exhibit-location">
              <i class="material-icons">location_on</i> Pabellón Paleontológico
            </div>
            <div class="exhibit-footer">
              <span class="exhibit-period">Permanente</span>
              <a href="#" class="view-link">Ver detalles <i class="material-icons" style="font-size:14px;">north_east</i></a>
            </div>
          </div>
        </div>
      </div>

      <!-- Exhibit 2 -->
      <div class="col s12 m6 l4" style="margin-bottom: 30px;">
        <div class="exhibit-card animate-in animate-in-delay-2">
          <div class="exhibit-img-container">
            <span class="exhibit-tag-overlay">Jurásico / Sala 03</span>
            <img src="https://images.unsplash.com/photo-1616712134411-6b6ae89bc3ba?q=80&w=800" alt="Fósil">
          </div>
          <div class="exhibit-content">
            <div class="exhibit-meta">
              <span class="exhibit-period">Periodo Jurásico</span>
              <span class="exhibit-tag">Novedad</span>
            </div>
            <h3 class="exhibit-title">Vestigios Gigantes</h3>
            <p class="exhibit-desc">Fósiles ancestrales de Estegosaurio. Un imponente herbívoro acorazado con placas dorsales.</p>
            <div class="exhibit-location">
              <i class="material-icons">location_on</i> Salón de la Evolución
            </div>
            <div class="exhibit-footer">
              <span class="exhibit-period">Temporal</span>
              <a href="#" class="view-link">Ver detalles <i class="material-icons" style="font-size:14px;">north_east</i></a>
            </div>
          </div>
        </div>
      </div>

      <!-- Exhibit 3 -->
      <div class="col s12 m6 l4" style="margin-bottom: 30px;">
        <div class="exhibit-card animate-in animate-in-delay-3">
          <div class="exhibit-img-container">
            <span class="exhibit-tag-overlay">Mesozoico / Sala 05</span>
            <img src="https://images.unsplash.com/photo-1579728469375-7bc093dc724b?q=80&w=800" alt="Raptor">
          </div>
          <div class="exhibit-content">
            <div class="exhibit-meta">
              <span class="exhibit-period">Era Mesozoica</span>
              <span class="exhibit-tag">Destacada</span>
            </div>
            <h3 class="exhibit-title">Depredadores Nocturnos</h3>
            <p class="exhibit-desc">Cráneos de Velociraptor. Descubre la garra letal del cazador más ágil de la prehistoria.</p>
            <div class="exhibit-location">
              <i class="material-icons">location_on</i> Sala de Depredadores
            </div>
            <div class="exhibit-footer">
              <span class="exhibit-period">Permanente</span>
              <a href="#" class="view-link">Ver detalles <i class="material-icons" style="font-size:14px;">north_east</i></a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script>
  document.addEventListener("DOMContentLoaded", async () => {
    const decoded = checkAuth(['user', 'admin']);
    if (decoded) {
      try {
        const res = await fetch('/api/users/me', {
          headers: { 'Authorization': 'Bearer ' + getToken() }
        });
        const data = await res.json();
        if (res.ok) {
          // Welcome message updated in hero tag
        }
      } catch (e) {}
    }
  });
</script>
<%- include('partials/footer') %>
