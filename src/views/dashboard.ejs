<%- include('partials/header') %>

<div class="museum-hero">
  <div class="museum-hero-content">
    <span class="hero-tag">01 / Colección Permanente</span>
    <h1>DESCUBRE<br><span class="accent">EL PASADO</span><br>// PREHISTÓRICO</h1>
    <p>Nuestra exposición permanente presenta los hallazgos paleontológicos más asombrosos del mundo, preservados para la humanidad.</p>
    <button class="btn btn-accent" style="margin-top: 10px;">Adquirir Entrada &nearr;</button>
  </div>
</div>

<div class="elegant-container">
  <div class="section-header">
    <span class="section-tag">02 / Exhibiciones Destacadas</span>
    <h2 class="section-title">EXPLORA LAS<br><span class="accent">COLECCIONES</span></h2>
  </div>

  <div class="container">
    <div class="exhibits-grid">
      <!-- Exhibit 1 -->
      <a href="/exhibit/1" style="text-decoration:none; display: block;">
        <div class="exhibit-card animate-in animate-in-delay-1">
          <div class="exhibit-img-container">
            <span class="exhibit-tag-overlay">Cretácico / Sala 01</span>
            <img src="/images/exhibit-1.jpg" alt="Esqueleto de T-Rex">
          </div>
          <div class="exhibit-content">
            <div class="exhibit-meta">
              <span class="exhibit-period">Periodo Cretácico</span>
              <span class="exhibit-tag">Permanente</span>
            </div>
            <h3 class="exhibit-title">El Rey de los Tiranos</h3>
            <p class="exhibit-desc">Esqueleto completo de Tyrannosaurus Rex montado en posición de caza. El depredador más temido.</p>
            <div class="exhibit-footer">
              <span class="exhibit-period">Pabellón Central</span>
              <span class="view-link">Ver detalles <i class="material-icons" style="font-size:14px;">north_east</i></span>
            </div>
          </div>
        </div>
      </a>

      <!-- Exhibit 2 -->
      <a href="/exhibit/2" style="text-decoration:none; display: block;">
        <div class="exhibit-card animate-in animate-in-delay-2">
          <div class="exhibit-img-container">
            <span class="exhibit-tag-overlay">Jurásico / Sala 03</span>
            <img src="/images/exhibit-2.jpg" alt="Fósil ammonite">
          </div>
          <div class="exhibit-content">
            <div class="exhibit-meta">
              <span class="exhibit-period">Periodo Jurásico</span>
              <span class="exhibit-tag">Novedad</span>
            </div>
            <h3 class="exhibit-title">Fósiles Marinos Ancestrales</h3>
            <p class="exhibit-desc">Colección de ammonites y criaturas marinas fosilizadas de hace 200 millones de años.</p>
            <div class="exhibit-footer">
              <span class="exhibit-period">Salón Oceánico</span>
              <span class="view-link">Ver detalles <i class="material-icons" style="font-size:14px;">north_east</i></span>
            </div>
          </div>
        </div>
      </a>

      <!-- Exhibit 3 -->
      <a href="/exhibit/3" style="text-decoration:none; display: block;">
        <div class="exhibit-card animate-in animate-in-delay-3">
          <div class="exhibit-img-container">
            <span class="exhibit-tag-overlay">Mesozoico / Sala 05</span>
            <img src="/images/exhibit-3.jpg" alt="Esqueleto de Triceratops">
          </div>
          <div class="exhibit-content">
            <div class="exhibit-meta">
              <span class="exhibit-period">Era Mesozoica</span>
              <span class="exhibit-tag">Destacada</span>
            </div>
            <h3 class="exhibit-title">Salón de los Gigantes</h3>
            <p class="exhibit-desc">Recorre la sala principal con esqueletos completos de las criaturas más grandes que pisaron la Tierra.</p>
            <div class="exhibit-footer">
              <span class="exhibit-period">Sala Principal</span>
              <span class="view-link">Ver detalles <i class="material-icons" style="font-size:14px;">north_east</i></span>
            </div>
          </div>
        </div>
      </a>

      <!-- Exhibit 4 -->
      <a href="/exhibit/4" style="text-decoration:none; display: block;">
        <div class="exhibit-card animate-in animate-in-delay-1">
          <div class="exhibit-img-container">
            <span class="exhibit-tag-overlay">Cretácico / Sala 02</span>
            <img src="/images/exhibit-4.jpg" alt="Cráneo de dinosaurio">
          </div>
          <div class="exhibit-content">
            <div class="exhibit-meta">
              <span class="exhibit-period">Cretácico Tardío</span>
              <span class="exhibit-tag">Temporal</span>
            </div>
            <h3 class="exhibit-title">Anatomía del Depredador</h3>
            <p class="exhibit-desc">Cráneos y mandíbulas articuladas que revelan la biomecánica letal de los carnívoros prehistóricos.</p>
            <div class="exhibit-footer">
              <span class="exhibit-period">Laboratorio</span>
              <span class="view-link">Ver detalles <i class="material-icons" style="font-size:14px;">north_east</i></span>
            </div>
          </div>
        </div>
      </a>

      <!-- Exhibit 5 -->
      <a href="/exhibit/5" style="text-decoration:none; display: block;">
        <div class="exhibit-card animate-in animate-in-delay-2">
          <div class="exhibit-img-container">
            <span class="exhibit-tag-overlay">Pleistoceno / Sala 07</span>
            <img src="/images/exhibit-5.jpg" alt="Fósil prehistórico">
          </div>
          <div class="exhibit-content">
            <div class="exhibit-meta">
              <span class="exhibit-period">Pleistoceno</span>
              <span class="exhibit-tag">Permanente</span>
            </div>
            <h3 class="exhibit-title">Megafauna de la Era de Hielo</h3>
            <p class="exhibit-desc">Esqueleto de Mamut Lanudo y otros mamíferos gigantes que dominaron las estepas heladas.</p>
            <div class="exhibit-footer">
              <span class="exhibit-period">Ala Glaciar</span>
              <span class="view-link">Ver detalles <i class="material-icons" style="font-size:14px;">north_east</i></span>
            </div>
          </div>
        </div>
      </a>

      <!-- Exhibit 6 -->
      <a href="/exhibit/6" style="text-decoration:none; display: block;">
        <div class="exhibit-card animate-in animate-in-delay-3">
          <div class="exhibit-img-container">
            <span class="exhibit-tag-overlay">Cenozoico / Sala 09</span>
            <img src="/images/exhibit-6.jpg" alt="Exhibición del museo">
          </div>
          <div class="exhibit-content">
            <div class="exhibit-meta">
              <span class="exhibit-period">Era Cenozoica</span>
              <span class="exhibit-tag">Exclusiva</span>
            </div>
            <h3 class="exhibit-title">Atrapados en Ámbar</h3>
            <p class="exhibit-desc">Insectos y plantas preservados en resina fósil durante millones de años. Ventanas al pasado intactas.</p>
            <div class="exhibit-footer">
              <span class="exhibit-period">Galería de Resinas</span>
              <span class="view-link">Ver detalles <i class="material-icons" style="font-size:14px;">north_east</i></span>
            </div>
          </div>
        </div>
      </a>
    </div>
  </div>
</div>
